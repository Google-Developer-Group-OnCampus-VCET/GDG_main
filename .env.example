# ==============================================================================
# Google Developer Groups on Campus (GDG) VCET - Production Environment Config
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Admin Authentication
# ------------------------------------------------------------------------------
# Admin password to unlock /admin/console and manage events/registrations.
ADMIN_PASSWORD=your-secure-admin-passcode-here
ADMIN_SECRET=your-secret-session-key-at-least-32-chars
# Optional: restrict allowed admin emails
ADMIN_EMAILS=vcet_gdg@vcet.edu.in

# ------------------------------------------------------------------------------
# 2. Email Service (Google Workspace / Gmail SMTP)
# ------------------------------------------------------------------------------
# Chapter official email: vcet_gdg@vcet.edu.in
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=vcet_gdg@vcet.edu.in
# Paste your 16-character Google Workspace App Password below (without spaces)
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# Alternatively:
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional sender label (defaults to "GDG on Campus VCET <vcet_gdg@vcet.edu.in>")
EMAIL_FROM=GDG on Campus VCET <vcet_gdg@vcet.edu.in>

# Optional alternative: Resend API Key
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. Firebase Server Admin Credentials (for Cloud Firestore sync)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=gdgoc-vcet
# Service Account client email from Google Cloud / Firebase console
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@gdgoc-vcet.iam.gserviceaccount.com
# Private key from Service Account JSON (escape newlines or enclose in quotes)
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. Public Firebase Web Config (Client-Side)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBQsuvEJwCtjZ4ZnhhZnrxLx-eW9xOh9MI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gdgoc-vcet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gdgoc-vcet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=gdgoc-vcet.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=588213745315
NEXT_PUBLIC_FIREBASE_APP_ID=1:588213745315:web:4059f5e1ca7ccacdef3116
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-FY41LG4GXD
