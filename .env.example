# GDG VCET Platform - Environment Variables
# Copy this file to .env.local for local overrides. Defaults are pre-configured for instant zero-setup execution.

# Chapter Configuration
NEXT_PUBLIC_CHAPTER_ID=gdg-vcet
NEXT_PUBLIC_CHAPTER_NAME="GDG on Campus VCET"
NEXT_PUBLIC_CHAPTER_CITY="Vasai, Mumbai"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication & Session Security
# Generate a secure 32+ character random secret in production
SESSION_SECRET="gdg-vcet-super-secret-key-change-in-production-min-32-chars"
SESSION_COOKIE_NAME="gdg_session"
SESSION_MAX_AGE_DAYS=7

# Database Configuration
# Defaults to Node 24 Native SQLite WAL in ./data/gdg.db
DATABASE_PATH="./data/gdg.db"

# Optional Cloud Integrations (Graceful Fallback to Local/Stub when omitted)
# Cloudinary (Banner & Proof Uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend / SMTP (Email Broadcasts & Ticket Deliveries)
RESEND_API_KEY=""
EMAIL_FROM="GDG VCET <events@gdgvcet.in>"

# QR / Barcode Check-In Security Token
CHECKIN_TERMINAL_SECRET="gdg-terminal-sec-key-vcet-2025"

