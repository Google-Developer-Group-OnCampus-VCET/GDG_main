# GDG VCET Platform - Environment Variables
# Copy this file to .env.local for local overrides. Defaults are pre-configured for instant zero-setup execution.

# Chapter Configuration
NEXT_PUBLIC_CHAPTER_ID=gdg-vcet
NEXT_PUBLIC_CHAPTER_NAME="GDG on Campus VCET"
NEXT_PUBLIC_CHAPTER_CITY="Vasai, Mumbai"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Session Cookie (the cookie itself is a Firebase session cookie — see Firebase section below)
SESSION_COOKIE_NAME="gdg_session"
SESSION_MAX_AGE_DAYS=5

# Database Configuration
# Defaults to Node 24 Native SQLite WAL in ./data/gdg.db. NOTE: file-based SQLite does not
# persist across Vercel's serverless function instances — see docs/engineering/
# DATABASE_HOSTING_DECISION.md before deploying there.
DATABASE_PATH="./data/gdg.db"

# Firebase — Client SDK config (safe to expose to the browser; see Firebase Console > Project
# Settings > General > Your apps). Leave unset to run against the Local Emulator Suite.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Only needed if you point the client at a non-default emulator host:port.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=""

# Firebase — Admin SDK (server only, never exposed to the browser). Required in production;
# not needed when FIREBASE_AUTH_EMULATOR_HOST / FIRESTORE_EMULATOR_HOST are set for local dev.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Set these (to 127.0.0.1:9099 / 127.0.0.1:9199) to run against the Firebase Local Emulator
# Suite instead of a live project — see docs/engineering/FIREBASE_SETUP.md.
FIREBASE_AUTH_EMULATOR_HOST=""
FIREBASE_STORAGE_EMULATOR_HOST=""

# Resend / SMTP (Announcement Email Delivery) — leave unset to keep announcements in "draft"
# status instead of implying delivery that never happened.
RESEND_API_KEY=""
EMAIL_FROM="GDG VCET <events@gdgvcet.in>"

